{
    "name": "frontend",
    "version": "0.0.0",
    "type": "module",
    "description": "The Music Assistant frontend developed in Vue.",
    "scripts": {
        "dev": "vite",
        "build": "vue-tsc --noEmit && vite build",
        "preview": "vite preview",
        "lint": "oxlint --deny-warnings && eslint . --fix --max-warnings=0 && pnpm format",
        "lint:check": "oxlint --deny-warnings && pnpm lint:eslint && pnpm format:check",
        "lint:oxlint": "oxlint --deny-warnings",
        "lint:eslint": "eslint . --max-warnings=0",
        "format": "prettier --write \"**/*.{js,cjs,ts,vue}\"",
        "format:check": "prettier --check \"**/*.{js,cjs,ts,vue}\"",
        "test": "vitest",
        "test:ui": "vitest --ui",
        "test:run": "vitest run",
        "test:coverage": "vitest run --coverage",
        "prepare": "husky"
    },
    "dependencies": {
        "@internationalized/date": "3.12.3",
        "@intlify/unplugin-vue-i18n": "11.2.5",
        "@lucide/vue": "^1.33.0",
        "@mdi/font": "7.4.47",
        "@scure/base": "^2.2.0",
        "@sendspin/sendspin-js": "5.0.0",
        "@tabler/icons-vue": "^3.46.0",
        "@tailwindcss/vite": "^4.3.3",
        "@tanstack/form-core": "1.33.0",
        "@tanstack/vue-form": "^1.33.0",
        "@tanstack/vue-table": "^8.21.3",
        "@tanstack/vue-virtual": "3.13.30",
        "@types/qrcode": "^1.5.6",
        "@vueuse/core": "^14.3.0",
        "butterchurn": "https://github.com/music-assistant/butterchurn/releases/download/v3.0.0-beta.5.ma.3/butterchurn-3.0.0-beta.5.ma.3.tgz",
        "butterchurn-presets": "3.0.0-beta.4",
        "canvas-confetti": "^1.9.4",
        "class-variance-authority": "^0.7.1",
        "clsx": "^2.1.1",
        "color": "5.0.3",
        "dompurify": "^3.4.11",
        "happy-dom": "^20.11.6",
        "marked": "^18.0.9",
        "mitt": "3.0.1",
        "mobile-detect": "1.4.5",
        "qrcode": "^1.5.4",
        "reka-ui": "^2.10.1",
        "swiper": "^14.1.0",
        "tailwind-merge": "^3.6.0",
        "tailwindcss": "^4.3.3",
        "ts-pattern": "^5.9.0",
        "tw-animate-css": "^1.4.0",
        "vue": "3.5.41",
        "vue-i18n": "11.4.8",
        "vue-qrcode-reader": "^5.7.3",
        "vue-router": "5.2.0",
        "vue-sonner": "^2.0.9",
        "vuetify": "3.12.0",
        "zod": "^4.4.3"
    },
    "devDependencies": {
        "@fontsource/roboto": "5.2.10",
        "@types/canvas-confetti": "^1.9.0",
        "@types/color": "4.2.1",
        "@types/node": "26.2.0",
        "@vitejs/plugin-vue": "6.0.8",
        "@vitest/coverage-v8": "^4.1.10",
        "@vitest/ui": "4.1.10",
        "@vue/eslint-config-typescript": "14.9.0",
        "@vue/test-utils": "^2.4.6",
        "@vue/tsconfig": "0.9.1",
        "eslint": "10.7.0",
        "eslint-config-prettier": "10.1.8",
        "eslint-plugin-oxlint": "^1.73.0",
        "eslint-plugin-vue": "10.10.0",
        "husky": "^9.1.7",
        "jsdom": "^30.0.1",
        "lint-staged": "^16.4.0",
        "material-design-icons-iconfont": "6.7.0",
        "oxlint": "^1.73.0",
        "prettier": "3.8.3",
        "sass": "1.102.0",
        "typescript": "6.0.3",
        "typescript-eslint": "^8.64.0",
        "vite": "^8.1.5",
        "vite-plugin-pwa": "1.3.0",
        "vite-plugin-vuetify": "2.1.3",
        "vite-plugin-webfont-dl": "3.12.0",
        "vitest": "^4.1.10",
        "vue-tsc": "3.3.7",
        "workbox-build": "^7.4.1",
        "workbox-precaching": "^7.4.1",
        "workbox-window": "^7.4.1"
    },
    "packageManager": "pnpm@11.8.0"
}
